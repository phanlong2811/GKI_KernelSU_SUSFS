+	/*
+	 * CIFS=y builds netfs in, but the stock system_dlkm still lists netfs.ko
+	 * in modules.load. Loading it fails on duplicate symbols and libmodprobe
+	 * then drops every module after it (modem data, Bluetooth). Report it as
+	 * already loaded, which libmodprobe accepts.
+	 */
+	if (IS_BUILTIN(CONFIG_NETFS_SUPPORT) && !strcmp(info->name, "netfs"))
+		return -EEXIST;
+
 	/*
 	 * Now that we know we have the correct module name, check
